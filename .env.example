# Copy this file to ".env" for local use, or set these in your hosting dashboard.
# NEVER commit the real .env file.

# Folder where ALL data is stored (database, uploads, certificates, backups, logs).
# Local use: leave empty (the project folder is used).
# Hosting: set to the path of your persistent disk, e.g. /var/data
MSES_STORAGE_ROOT=

# Optional: protects the very first administrator setup on a public website.
# Anyone opening the site before you finish setup would need this code.
MSES_SETUP_CODE=

# Public address of the website (used inside the certificate QR code).
# Example: https://motilal-events.onrender.com
MSES_PUBLIC_URL=

# Time zone used for deadlines and displayed times.
MSES_TIMEZONE=Asia/Kolkata
